{
  "name": "huanyu-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source Mandarin Chinese Learning Platform",
  "license": "MIT",
  "scripts": {
    "dev": "make -C apps/backend dev & turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:js": "turbo lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "prepare": "husky",
    "data:generate-manifest": "bun run --filter @navia/media generate-manifest",
    "data:generate-audio": "bun run --filter @navia/media generate-audio",
    "data:generate-images": "bun run --filter @navia/media generate-images",
    "data:validate-images": "bun run --filter @navia/media validate-images",
    "data:regenerate-images": "bun run --filter @navia/media regenerate-images",
    "data:import-anki": "bun run --filter @navia/media import-anki",
    "data:publish": "bun run --filter @navia/media publish-data",
    "backend:dev": "make -C apps/backend dev",
    "backend:build": "make -C apps/backend build",
    "backend:typecheck": "cd apps/backend && go vet ./cmd/... ./internal/... ./pkg/..."
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx}": [
      "bun x eslint --config apps/web/eslint.config.mjs --fix",
      "prettier --write"
    ],
    "apps/mobile/**/*.{js,jsx,ts,tsx}": [
      "bun x eslint --config apps/mobile/eslint.config.mjs --fix",
      "prettier --write"
    ],
    "apps/media/**/*.{js,jsx,ts,tsx}": [
      "bun x eslint --config apps/media/eslint.config.mjs --fix",
      "prettier --write"
    ],
    "*.md": "markdownlint-cli2 --fix",
    "*.{json,css,scss,yml,yaml}": "prettier --write",
    "*.go": "bash -c 'command -v golangci-lint >/dev/null 2>&1 && golangci-lint run --fix \"$@\" || echo \"[lint-staged] golangci-lint tidak terinstall — skip (warning)\" \"$@\"' --"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.23.2",
    "npm-check-updates": "^22.1.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.4"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "apps/media",
    "packages/*"
  ]
}
