    "gender": "female"
  },
  {
    "key": "char:c-ri",
    "text": "日",
    "locale": "zh-CN",
    "language": "zh",
    "examSource": "hsk",
    "gender": "male"
  },
  {
    "key": "char:c-yue",
    "text": "月",
    "locale": "zh-CN",
    "language": "zh",
    "examSource": "hsk",
    "gender": "male"
  },
  {
    "key": "char:c-shan",
    "text": "山",
    "locale": "zh-CN",
    "language": "zh",
    "examSource": "hsk",
    "gender": "female"
  },
  {
    "key": "char:c-shui",
    "text": "水",
    "locale": "zh-CN",
    "language": "zh",
    "examSource": "hsk",
    "gender": "male"
