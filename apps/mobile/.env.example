# ─── API ───────────────────────────────────────────────────────────────
# Base URL of the Go Fiber backend. Must be reachable from the device:
# - iOS/Android emulator on same machine → http://localhost:8080/api/v1
# - Physical device on same LAN          → http://192.168.x.x:8080/api/v1
# - Staging / production                 → https://api.navia.example.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Public S3/R2 base URL where the backend uploads TTS audio + curriculum media.
# Must match STORAGE_PUBLIC_URL on the backend; mobile uses it only as fallback
# if the backend returns a relative URL (it shouldn't, but defensive).
EXPO_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/navia-data

# Content CDN base (R2/RustFS) — vocab/curriculum bundles via data-manifest.
# Default = EXPO_PUBLIC_MEDIA_BASE_URL. Set eksplisit bila CDN beda dari media.
# EXPO_PUBLIC_DATA_CDN_URL=http://localhost:9000/navia-data

# Audio asset base (dipakai useTts untuk resolve audio per teks).
# Default = EXPO_PUBLIC_MEDIA_BASE_URL.
# EXPO_PUBLIC_AUDIO_CDN_URL=http://localhost:9000/navia-data

# Optional — enable verbose API logging in dev. "1" or "0".
EXPO_PUBLIC_API_DEBUG=0
