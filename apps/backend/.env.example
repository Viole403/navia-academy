# Local dev secrets for the Go/Fiber backend. Copy to .env and fill in.
#
# Database options (pick one):
#   - Root `docker compose up -d`  → full dev stack (postgres+redis+api), creds navia/navia-dev
#   - `docker run` pg/redis manual → same DATABASE_URL/REDIS_URL as below
#   - Cloud managed (Neon/Upstash) → see TLS notes per variable
# Migrations are ALWAYS manual: psql "$DATABASE_URL" -f migrations/*.sql

# Server
SERVER_PORT=8080

# Database (self-hosted Postgres in dev; managed cloud in prod)
# Managed providers (Neon/Supabase) need TLS: append ?sslmode=require
# DATABASE_URL=postgresql://user:pass@ep-xyz.region.neon.tech/navia?sslmode=require
DATABASE_URL=postgresql://navia:navia-dev@localhost:5432/navia

# Redis (self-hosted in dev; managed cloud in prod)
# Managed providers (e.g. Upstash) use the TLS scheme:
# REDIS_URL=rediss://default:PASSWORD@host.upstash.io:6379
REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=

# JWT — HS256 secrets (min 32 chars). Change in production!
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-32chars

# App
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Google OAuth (implicit flow; redirect defaults to SITE_URL/auth/callback)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_REDIRECT_URL=

# Donation webhooks (Ko-fi / Trakteer) — verification for supporter wall
KOFI_VERIFICATION_TOKEN=
TRAKTEER_WEBHOOK_SECRET=

# Content export bridge — shared secret for GET /api/v1/content/export,
# consumed by apps/media's sync script (bun run sync-content). This is an
# app-to-app HTTP bearer token ONLY: it grants no database access on either
# side (the two apps intentionally use separate Supabase/Postgres projects).
# Generate a strong random value (e.g. openssl rand -hex 32) and set the
# IDENTICAL string in apps/media (.env.local CONTENT_EXPORT_TOKEN). Leave
# empty to disable the export endpoint entirely (503 EXPORT_DISABLED).
CONTENT_EXPORT_TOKEN=

# Media signing — serve private audio/image objects via short-lived presigned URLs.
# Same credentials as apps/media/.env.local MEDIA_STORAGE_*.
# STORAGE_ENDPOINT=http://localhost:9000        # RustFS/MinIO dev (omit for AWS S3)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=navia-data
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# TTS
TTS_ENGINE=edge

# Resource caps (auto-generated by scripts/compute-resource-limits.sh from the
# host's real vCPU/RAM — do not hand-edit; re-run after any VPS plan change).
# api and media batch jobs never run concurrently, so EACH gets the full
# budget when it is the one running.
API_CPU_LIMIT=
API_MEM_LIMIT=
API_MEM_LIMIT_BYTES=   # passed into the api container; Go GC soft limit = 90% of this
MEDIA_CPU_LIMIT=
MEDIA_MEM_LIMIT=

# apps/media batch guard: warns if the api's health endpoint answers before a
# batch run starts (they share one budget and must not overlap).
#   unset | warn -> loud warning, continue   (default)
#   strict       -> refuse to start (exit 1)
#   off          -> skip the check entirely (deliberate overlap)
# MEDIA_BATCH_GUARD=
# MEDIA_API_HEALTH_URL=http://localhost:8080/api/v1/health

# Content-levels whitelist (published by apps/media to the CDN).
# Empty -> derived from STORAGE_PUBLIC_URL + /data/content-levels.json;
# if both are unset the backend uses its embedded fallback only.
# CONTENT_LEVELS_URL=

# ─── Optional (dibaca internal/config/config.go) ─────────────────────────
# JWT durations & issuer
# JWT_ACCESS_DURATION=15m
# JWT_REFRESH_DURATION=168h
# JWT_ISSUER=navia-academy
# Redis auth (selain URL)
# REDIS_PASSWORD=
# Public base URL bucket (derivasi CONTENT_LEVELS_URL; dipakai juga /tts upload)
# STORAGE_PUBLIC_URL=http://localhost:9000/navia-data
# TTS fallback chain & defaults
# GOOGLE_TTS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia
# TTS_DEFAULT_LOCALE=zh-CN
# TTS_DEFAULT_GENDER=female
# Audio serving
# AUDIO_BASE_URL=/audio
# AUDIO_MAX_FILE_SIZE_MB=5
# Global API rate limit (req/menit per identifier; endpoint tertentu punya limit sendiri)
# RATE_LIMIT_PER_MIN=60
# Logging
# LOG_LEVEL=info
# SMTP password-reset email (kosong = fitur off)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@navia.academy
