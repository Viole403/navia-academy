[
  {
    "id": "de-conv-001",
    "language": "de",
    "title": "Im Café (At the Café)",
    "level": 1,
    "difficulty": 2,
    "examMappings": {},
    "scenario": "café",
    "speakers": [
      {
        "id": "waiter",
        "name": "Kellner (Waiter)",
        "role": "waiter"
      },
      {
        "id": "customer",
        "name": "Kunde (Customer)",
        "role": "customer"
      }
    ],
    "dialogue": [
      {
        "speaker": "waiter",
        "text": "Guten Tag! Was möchten Sie trinken?",
        "romanization": null,
        "translation": "Good day! What would you like to drink?",
        "audio": "de_conv001_01.mp3",
        "translation_en": "Good day! What would you like to drink?",
        "translation_id": "Selamat siang! Mau minum apa?"
      },
      {
        "speaker": "customer",
        "text": "Guten Tag! Ich möchte einen Kaffee, bitte.",
        "romanization": null,
        "translation": "Good day! I would like a coffee, please.",
        "audio": "de_conv001_02.mp3",
        "translation_en": "Good day! I would like a coffee, please.",
        "translation_id": "Selamat siang! Saya mau kopi, tolong."
      },
      {
        "speaker": "waiter",
        "text": "Mit Milch und Zucker?",
        "romanization": null,
        "translation": "With milk and sugar?",
        "audio": "de_conv001_03.mp3",
        "translation_en": "With milk and sugar?",
        "translation_id": "Dengan susu dan gula?"
      },
      {
        "speaker": "customer",
        "text": "Nur mit Milch, bitte.",
        "romanization": null,
        "translation": "Just with milk, please.",
        "audio": "de_conv001_04.mp3",
        "translation_en": "Just with milk, please.",
        "translation_id": "Susu saja, tolong."
      },
      {
        "speaker": "waiter",
        "text": "Möchten Sie auch etwas essen?",
        "romanization": null,
        "translation": "Would you also like something to eat?",
        "audio": "de_conv001_05.mp3",
        "translation_en": "Would you also like something to eat?",
        "translation_id": "Mau juga makan sesuatu?"
      },
      {
        "speaker": "customer",
        "text": "Ja, ein Croissant, bitte.",
        "romanization": null,
        "translation": "Yes, a croissant, please.",
        "audio": "de_conv001_06.mp3",
        "translation_en": "Yes, a croissant, please.",
        "translation_id": "Ya, satu croissant, tolong."
      },
      {
        "speaker": "waiter",
        "text": "Sehr gern. Kommt sofort!",
        "romanization": null,
        "translation": "With pleasure. Coming right away!",
        "audio": "de_conv001_07.mp3",
        "translation_en": "With pleasure. Coming right away!",
        "translation_id": "Dengan senang hati. Sebentar lagi!"
      }
    ],
    "vocabulary": [
      "de_kaffee",
      "de_milch",
      "de_bitte",
      "de_essen"
    ],
    "grammar": [
      "de_modal_verbs",
      "de_word_order"
    ],
    "culturalNotes": "In German cafés, it's common to say 'Guten Tag' or 'Guten Morgen' when entering. Table service is standard, and you typically order from a waiter rather than at a counter.",
    "tags": [
      "café",
      "food",
      "ordering",
      "A1"
    ],
    "culturalNotes_en": "In German cafés, it's common to say 'Guten Tag' or 'Guten Morgen' when entering. Table service is standard, and you typically order from a waiter rather than at a counter.",
    "culturalNotes_id": "Di kafe Jerman, biasanya mengucapkan 'Guten Tag' atau 'Guten Morgen' saat masuk. Layanan meja adalah standar, dan biasanya memesan ke pelayan, bukan di konter."
  },
  {
    "id": "de-conv-002",
    "language": "de",
    "title": "Sich vorstellen (Introducing Yourself)",
    "level": 1,
    "difficulty": 1,
    "examMappings": {},
    "scenario": "introduction",
    "speakers": [
      {
        "id": "anna",
        "name": "Anna",
        "role": "person1"
      },
      {
        "id": "max",
        "name": "Max",
        "role": "person2"
      }
    ],
    "dialogue": [
      {
        "speaker": "anna",
        "text": "Hallo! Ich heiße Anna. Wie heißt du?",
        "romanization": null,
        "translation": "Hello! My name is Anna. What's your name?",
        "audio": "de_conv002_01.mp3",
        "translation_en": "Hello! My name is Anna. What's your name?",
        "translation_id": "Halo! Nama saya Anna. Siapa namamu?"
      },
      {
        "speaker": "max",
        "text": "Hallo Anna! Ich bin Max. Woher kommst du?",
        "romanization": null,
        "translation": "Hello Anna! I'm Max. Where are you from?",
        "audio": "de_conv002_02.mp3",
        "translation_en": "Hello Anna! I'm Max. Where are you from?",
        "translation_id": "Halo Anna! Saya Max. Dari mana asalmu?"
      },
      {
        "speaker": "anna",
        "text": "Ich komme aus Spanien. Und du?",
        "romanization": null,
        "translation": "I'm from Spain. And you?",
        "audio": "de_conv002_03.mp3",
        "translation_en": "I'm from Spain. And you?",
        "translation_id": "Saya dari Spanyol. Kalau kamu?"
      },
      {
        "speaker": "max",
        "text": "Ich komme aus Deutschland, aus Berlin.",
        "romanization": null,
        "translation": "I'm from Germany, from Berlin.",
        "audio": "de_conv002_04.mp3",
        "translation_en": "I'm from Germany, from Berlin.",
        "translation_id": "Saya dari Jerman, dari Berlin."
      },
      {
        "speaker": "anna",
        "text": "Schön! Wie lange lernst du Spanisch?",
        "romanization": null,
        "translation": "Nice! How long have you been learning Spanish?",
        "audio": "de_conv002_05.mp3",
        "translation_en": "Nice! How long have you been learning Spanish?",
        "translation_id": "Bagus! Sudah berapa lama kamu belajar bahasa Spanyol?"
      },
      {
        "speaker": "max",
        "text": "Ich lerne seit einem Jahr. Es ist interessant!",
        "romanization": null,
        "translation": "I've been learning for a year. It's interesting!",
        "audio": "de_conv002_06.mp3",
        "translation_en": "I've been learning for a year. It's interesting!",
        "translation_id": "Saya sudah belajar selama setahun. Menarik!"
      }
    ],
    "vocabulary": [
      "de_ich_heisse",
      "de_woher",
      "de_deutschland"
    ],
    "grammar": [
      "de_pronouns",
      "de_present_tense"
    ],
    "culturalNotes": "Germans typically use 'du' with friends and peers, but 'Sie' in formal settings. When introducing yourself, 'Ich heiße...' or 'Ich bin...' are both acceptable.",
    "tags": [
      "introduction",
      "greetings",
      "countries",
      "A1"
    ],
    "culturalNotes_en": "Germans typically use 'du' with friends and peers, but 'Sie' in formal settings. When introducing yourself, 'Ich heiße...' or 'Ich bin...' are both acceptable.",
    "culturalNotes_id": "Orang Jerman biasanya memakai 'du' untuk teman dan sebaya, tapi 'Sie' untuk situasi formal. Saat memperkenalkan diri, 'Ich heiße...' atau 'Ich bin...' keduanya diterima."
  },
