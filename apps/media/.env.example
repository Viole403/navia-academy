# ─── Storage (S3-compatible: local RustFS / R2 / GCS / S3 / MinIO) ─────────
# Local dev (RustFS di :9000). Kredensial tersimpan di volume /data (.rustfs.sys);
# jangan recreate container tanpa mount volume /home/yuzusa/rustfs/data:/data,
# atau IAM user + bucket akan hilang.
# WAJIB saat recreate: enable CORS pada S3 API agar browser web bisa memuat audio:
#   -e RUSTFS_CORS_ALLOWED_ORIGINS='*'
#   -e RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS='*'
# Kredensial ini TIDAK boleh berubah saat recreate (dipulihkan dari /data):
MEDIA_STORAGE_PROVIDER=s3
MEDIA_STORAGE_BUCKET=navia-data
MEDIA_STORAGE_REGION=us-east-1
MEDIA_STORAGE_ENDPOINT=http://localhost:9000
MEDIA_STORAGE_ACCESS_KEY=rustfsadmin
MEDIA_STORAGE_SECRET_KEY=rustfsadmin
MEDIA_STORAGE_PUBLIC_URL=http://localhost:9000/navia-data

# Produksi:
#   R2:    MEDIA_STORAGE_PROVIDER=r2  ENDPOINT=https://<account>.r2.cloudflarestorage.com  REGION=auto
#   GCS:   ENDPOINT=https://storage.googleapis.com (interop) atau pakai credentials
#   AWS:   ENDPOINT= (kosong) REGION=us-east-1
# MEDIA_STORAGE_PUBLIC_URL=           # base public URL bucket (untuk CDN/asset URL)

# ─── TTS ───────────────────────────────────────────────────────────────────
MEDIA_TTS_ENGINE=edge                 # edge | google | azure
# GOOGLE_TTS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastasia
# TTS keys can also live in the `tts_api_keys` table (migrations/0004_tts_api_keys.sql)
# for central editing in the dashboard + round-robin rotation with per-key cooldown.
# Requires CONTENT_SUPABASE_URL + CONTENT_SUPABASE_SERVICE_ROLE_KEY below; when the
# table is unreachable/empty the flat env keys above are used as fallback.
# Cooldown (ms) applied to a pooled TTS key after a 429/quota error (default 10 min):
# MEDIA_TTS_KEY_COOLDOWN_MS=600000

# ─── Supabase (key pools + settings) ─────────────────────────────────────────
# The dashboard (/keys → Provider tab) and CLI/GHA read pooled image/TTS API keys
# and pipeline settings from Supabase tables (image_api_keys, tts_api_keys,
# media_settings). Flat env keys (MEDIA_IMAGE_*, MEDIA_TTS_*) are the fallback
# when the tables are unreachable/empty.
# CONTENT_SUPABASE_URL=
# CONTENT_SUPABASE_SERVICE_ROLE_KEY=

# ─── Pipeline settings (provider/engine, DB-editable) ───────────────────────
# Active image provider + TTS engine can be stored in the `media_settings` table
# (migrations/0005_media_settings.sql) and edited from the dashboard (/keys →
# Provider tab). Precedence: explicit env var > DB setting > default. When env
# is left empty here, the DB value (set in the dashboard) takes effect.

# ─── Media Studio dashboard auth ────────────────────────────────────────────
# Shared secret for the whole dashboard (pages + API routes). Set it to lock the
# dashboard; when unset the dashboard stays open for local dev convenience.
# MEDIA_ADMIN_TOKEN=change-me

# AES-256-GCM encryption key for api_key columns at rest.
# Generate: openssl rand -hex 32
# Empty = plaintext (legacy/dev only)
# MEDIA_KEY_ENCRYPTION_KEY=

# ─── Image generation ──────────────────────────────────────────────────────
# Provider: openai | gemini | deepai | cloudflare
MEDIA_IMAGE_PROVIDER=openai
MEDIA_IMAGE_API_KEY=
MEDIA_IMAGE_API_BASE_URL=https://api.openai.com/v1
MEDIA_IMAGE_MODEL=gpt-image-1
# Size: square side ("512") or full WxH ("1024x1536"); unset = model default.
# gpt-image-1 only accepts 1024x1024 | 1536x1024 | 1024x1536 | auto — it always
# returns b64_json and rejects the `response_format` parameter (dall-e-* only).
# MEDIA_IMAGE_SIZE=1024x1536
MEDIA_IMAGE_RATE_LIMIT_MS=1000
# MEDIA_IMAGE_GEMINI_MODEL=gemini-3.1-flash-image
# Cooldown (ms) applied to a pooled key after a 429/quota error (default 10 min):
# MEDIA_IMAGE_KEY_COOLDOWN_MS=600000
# Image keys can live in the `image_api_keys` table (migrations/0003_image_api_keys.sql)
# for central editing in the dashboard + round-robin rotation with per-key cooldown.
# Requires CONTENT_SUPABASE_URL + CONTENT_SUPABASE_SERVICE_ROLE_KEY above; when the
# table is unreachable/empty the flat env keys below are used as fallback.
# Vision (validate-images) memakai pool yang SAMA tapi provider terpisah:
#   MEDIA_VISION_PROVIDER=gemini        # gemini (default, vision gratis) | openai | cloudflare
#   MEDIA_VISION_OPENAI_MODEL=gpt-4o-mini
#   MEDIA_VISION_CF_MODEL=@cf/meta/llama-3.2-11b-vision-instruct-wasi
# Tambahkan key vision via dashboard /keys (mis. provider=gemini, name=gemini-vision);
# fallback env GEMINI_API_KEY bila DB tanpa key vision.
# Cloudflare Workers AI (gratis 10k neuron/hari, tanpa kartu kredit):
#   MEDIA_IMAGE_PROVIDER=cloudflare
#   MEDIA_IMAGE_CF_ACCOUNT_ID=<account-id>          # dari dash.cloudflare.com (URL /<account-id>/home)
#   MEDIA_IMAGE_CF_API_TOKEN=<workers-ai-token>     # My Profile → API Tokens → Create Token → Workers AI
#   MEDIA_IMAGE_CF_MODEL=@cf/black-forest-labs/flux-1-schnell
#   Endpoint: POST /client/v4/accounts/{id}/ai/run/{model} → { result: { image: base64 } }
# DeepAI (web-UI "try it" scrape — official API requires paid Pro subscription):
#   MEDIA_IMAGE_PROVIDER=deepai   (tanpa key → pakai kuota anonim gratis, rate-limit per IP)
#   MEDIA_IMAGE_DEEPAI_PAID_KEY=<deepai-paid-key>   (opsional: bypass kuota dengan key API paid)
#   MEDIA_IMAGE_DEEPAI_MODEL=3d-cartoon-generator
#   MEDIA_IMAGE_DEEPAI_UA / MEDIA_IMAGE_DEEPAI_SALT / MEDIA_IMAGE_DEEPAI_ENDPOINT  (override bila berubah)
# Anti-bot gate (401 "Please try this model on deepai.org") memicu fallback ke headless Chrome
# (puppeteer-core, pakai Chrome sistem — tanpa download browser). Butuh Chrome/Chromium terpasang
# (sudah preinstalled di GH Actions runner); lokal: /usr/bin/google-chrome, /usr/bin/chromium,
# atau set CHROME_PATH.

# ─── Content export bridge (apps/backend → apps/media) ─────────────────────
# Used by `bun run sync-content`: fetches published content_items from the Go API
# over HTTP and merges them into data/json before publish-data. The two apps
# intentionally use SEPARATE database projects — this token is an HTTP bearer
# secret ONLY and grants NO database access to either side.
#   CONTENT_API_BASE_URL  base URL of apps/backend (no trailing slash)
#   CONTENT_EXPORT_TOKEN  MUST equal CONTENT_EXPORT_TOKEN in apps/backend/.env
#                         in the same environment (generate: openssl rand -hex 32)
# CONTENT_API_BASE_URL=http://localhost:8080
# CONTENT_EXPORT_TOKEN=

# ─── Dashboard → GitHub Actions trigger (POST /api/generate/batch) ──────────
# Dipakai route trigger batch untuk men-dispatch workflow media-generate dari
# jarak jauh (relevan saat dashboard di-deploy ke Vercel). Lokal: kosongkan —
# route akan jawab 503 GITHUB_NOT_CONFIGURED.
#   GH_PAT       fine-grained PAT, 1 repo saja, scope "Actions: read & write"
#   GH_REPO      "owner/repo"
#   GH_WORKFLOW  nama file workflow   (default: media-generate.yml)
#   GH_REF       branch dispatch      (default: main)
# GH_PAT=
# GH_REPO=owner/repo
# GH_WORKFLOW=media-generate.yml
# GH_REF=main

# ─── Batch generation tuning + guard ─────────────────────────────────────
# Concurrency TTS saat generate-audio (default aman untuk VPS kecil):
# MEDIA_TTS_CONCURRENCY=4
# Checkpoint file agar run ulang lanjut (bukan dari nol); checkpoint lokal = optimasi,
# dedup R2 unconditional tetap jalan:
# MEDIA_TTS_CHECKPOINT=.output/tts-checkpoint.json
# Rate limit per request TTS (ms antar call):
# MEDIA_TTS_RATE=0
# Ukuran gambar yang diminta ke provider:
# MEDIA_IMAGE_SIZE=1024x1024
# Guard mutual-exclusion dengan API backend (share budget CPU/RAM VPS — tidak boleh
# overlap). unset|warn = peringatan keras lalu lanjut; strict = exit 1; off = skip.
# MEDIA_BATCH_GUARD=warn
# MEDIA_API_HEALTH_URL=http://localhost:8080/api/v1/health
